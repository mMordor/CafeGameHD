# Copy to .env.local and fill in. Never commit real values.

# ---------------------------------------------------------------------------
# Business settings (these three are public: they are compiled into the site)
# ---------------------------------------------------------------------------
# IANA timezone of the venue. Default is Asia/Tehran (a placeholder; set the real one).
NEXT_PUBLIC_BUSINESS_TIMEZONE=Asia/Tehran
# Bookable hours (24h). 24 means midnight. Placeholders until the owner confirms them.
NEXT_PUBLIC_OPEN_HOUR=10
NEXT_PUBLIC_CLOSE_HOUR=24
# Longest single booking in hours (placeholder).
NEXT_PUBLIC_MAX_HOURS=5

# Optional 3D model of the gaming PC (.glb). Example: /models/gaming-pc.glb
# Leave empty to use the built-in illustration.
NEXT_PUBLIC_PC_MODEL_URL=

# ---------------------------------------------------------------------------
# Staff login (/admin/login)
# ---------------------------------------------------------------------------
# REQUIRED in production: long random secret used to sign login cookies (16+ chars).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Admin: view, add, edit, change status AND permanently delete.
ADMIN_USERNAME=
# Use a hash (recommended):  npm run hash-password   (prints scrypt$... )
ADMIN_PASSWORD_HASH=
# ...or a plain password (less safe). Ignored when a hash is set.
ADMIN_PASSWORD=

# Manager: view, add phone reservations, edit, change status. Cannot delete.
MANAGER_USERNAME=
MANAGER_PASSWORD_HASH=
MANAGER_PASSWORD=

# In development only (npm run dev) with nothing set, these built-in logins work:
#   admin / admin123   and   manager / manager123
# They are DISABLED when NODE_ENV=production.

# Set to true ONLY when the site runs behind a reverse proxy you control that
# overwrites X-Forwarded-For. Used for per-IP rate limiting.
TRUST_PROXY=false
# Set to false only to test `next start` over plain http://localhost.
COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Folder for the local JSON store (default ./data).
DATA_DIR=
# The JSON file store is for local development and a SINGLE server with a persistent
# disk. In production it is refused unless you explicitly allow it:
ALLOW_FILE_STORAGE=false
# PostgreSQL (Supabase / Neon). NOT IMPLEMENTED in this build: setting it makes the
# app refuse to start the reservation service instead of silently using files.
# See README and db/schema.sql.
DATABASE_URL=
